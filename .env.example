# suscripcion-api environment variables
# Copy to .env.local for local development. Vercel: Settings → Environment Variables.
#
# SERVER-ONLY variables (Secret in Vercel — NEVER expose to the client):
# Supabase anon key — server-only. Aunque sea la anon key (pública por diseño
# en Supabase), este endpoint es solo backend; no se expone al navegador.
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase service_role key — used by /api/webhook and /api/crear-preferencia.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# MercadoPago access token — TEST token for sandbox, or production token.
# Get a TEST token at https://www.mercadopago.com.ar/developers under Credenciales.
MP_ACCESS_TOKEN=TEST-your_mercadopago_token_here

# NOTIFICATION_URL is derived from the Vercel origin at runtime — do NOT set manually.