# Variables de entorno — SOLO NOMBRES, sin valores.
# Copiar a `.env` (local) o cargar en el proveedor de despliegue (Vercel).
#
# El webhook (`app/api/webhook/route.ts`) NO tiene ningún valor por defecto:
# si falta cualquiera de estas tres, responde 503 a propósito para que
# MercadoPago reintente, y no activa nada. Ver `lib/mp-contract.mjs`.

# Proyecto de Supabase del operador. DEBE ser el mismo proyecto que lee CANYP
# (`backend/config.py` -> `SUPABASE_URL`, cargado desde su `backend/.env`). Si
# difieren, el pago se registra donde el backend no mira y la licencia nunca
# se activa.
NEXT_PUBLIC_SUPABASE_URL=

# Credencial de PRIVILEGIO (service_role). Es un secreto: nunca va en el
# repo, nunca en `NEXT_PUBLIC_*`, nunca en el bundle del cliente. Sin ella la
# escritura se deniega por RLS y la licencia no se activa.
SUPABASE_SERVICE_ROLE_KEY=

# Token de producción de MercadoPago. Sin él no se puede verificar que el pago
# esté `approved` ni cuánto se cobró, así que el webhook no activa nada.
MP_ACCESS_TOKEN=

# Opcionales (no bloquean la activación):
#
# Clave pública de Supabase. La usan los otros handlers que solo LEEN.
# NEXT_PUBLIC_SUPABASE_KEY=
#
# Secreto de validación de firma de webhooks (MercadoPago lo entrega en
# "Tus integraciones > Webhooks"). Habilitarlo agrega la verificación del
# header `x-signature`; hoy la seguridad se apoya en verificar el pago contra
# la API de MercadoPago, no en la firma.
# MP_WEBHOOK_SECRET=